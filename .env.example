# Copy to .env.local and fill in. NEXT_PUBLIC_* values are inlined at build time.

# API base URL. Leave unset to use the same-origin /api/v1 proxy.
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Mapbox public token (pk.*) for the campaign targeting map.
# Without it the targeting page shows a notice instead of the map.
NEXT_PUBLIC_MAPBOX_TOKEN=
