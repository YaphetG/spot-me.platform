# Copy to .env.local and adjust. NEXT_PUBLIC_* values are inlined at build
# time, so rebuild (or restart `npm run dev`) after changing them.

# Base URL the browser uses for API calls. Leave unset to use the same-origin
# /api/v1, which Next.js proxies to API_PROXY_TARGET (no CORS needed).
# Set it to call a deployed API directly, e.g. https://api.example.com/api/v1
NEXT_PUBLIC_API_BASE_URL=

# Where the Next.js server forwards /api/v1/* when NEXT_PUBLIC_API_BASE_URL is
# unset. Read by next.config.ts.
API_PROXY_TARGET=http://localhost:8000
